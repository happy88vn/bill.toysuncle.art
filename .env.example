# =============================================================
# Toys Uncle — Bill / Expense Tracker — bien moi truong mau
# Copy file nay thanh .env (local) HOAC nhap tung bien tren Vercel.
# KHONG dien gia tri that vao file .example nay.
# =============================================================

# --- Database (Neon Postgres) ---
# Lay tu Neon: Dashboard > Connection string > "Pooled" (co ?sslmode=require)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# --- NextAuth ---
# NEXTAUTH_URL = domain that cua app (production)
NEXTAUTH_URL="https://bill.toysuncle.art"
# Chuoi bi mat ngau nhien: openssl rand -base64 32
NEXTAUTH_SECRET=""

# --- Luu anh bill: Cloudflare R2 (tuong thich S3) ---
# S3_ENDPOINT = https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
AWS_REGION="auto"
AWS_BUCKET_NAME="bill-toysuncle"
AWS_FOLDER_PREFIX=""
# Chi can neu co object public (custom domain / r2.dev). Bill mac dinh private nen co the de trong.
S3_PUBLIC_BASE_URL=""

# --- AI doc bill (Abacus LLM, endpoint public van dung duoc) ---
ABACUSAI_API_KEY=""

# --- Google Sheets (service account) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# Dan nguyen private key, giu \n. Tren Vercel dan ca khoi -----BEGIN...-----END-----
GOOGLE_PRIVATE_KEY=""
GOOGLE_SPREADSHEET_ID="1AQuUFd1CtEC6nRS8tGBMRdmuZ6TuR_jLNEUmjXt135c"

# --- Google Drive (OAuth2 user token + folder dich) ---
GOOGLE_DRIVE_BILL_FOLDER_ID=""
GOOGLE_DRIVE_PARENT_FOLDER_ID=""
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# --- Google SSO dang nhap app (NextAuth GoogleProvider) ---
# Co the trung voi GOOGLE_OAUTH_* o tren neu dung chung 1 OAuth client.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Danh sach email duoc phep dang nhap (ap dung MOI cach: Google SSO + mat khau), ngan cach dau phay
ALLOWED_EMAILS="email1@gmail.com,email2@gmail.com"

# --- Tai khoan admin tao boi seed (chay `prisma db seed`) ---
# SEED_EMAIL phai nam trong ALLOWED_EMAILS, neu khong se bi chan dang nhap.
SEED_EMAIL="email1@gmail.com"
SEED_PASSWORD=""
SEED_NAME="Admin"
